# Core runtime
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=qwen3:1.7b
OLLAMA_DEEP_MODEL=qwen3:8b
OLLAMA_CODE_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=768
OLLAMA_NUM_PREDICT=256
ENABLE_DIRECT_OLLAMA_FALLBACK=true

# MCP runtime
MCP_ENABLED=true
MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=python -m server.mcp_server.app
MCP_WORKING_DIRECTORY=D:/burp-ai-bridge-main/burp-ai-bridge-main
MCP_TOOL_NAME=analyze_security_exchange
MCP_TIMEOUT_SECONDS=60
MODEL_PROVIDER_ORDER=mcp,ollama
DEFAULT_BOUNTY_PLATFORM=generic

# Burp Suite Pro MCP extension context
BURP_MCP_CONTEXT_ENABLED=true
BURP_MCP_TRANSPORT=auto
BURP_MCP_SERVER_URL=http://127.0.0.1:9876
BURP_MCP_PROXY_COMMAND=
MCP_TIMEOUT_SECONDS=15
BURP_MCP_TIMEOUT_SECONDS=20
BURP_MCP_CONTEXT_HISTORY_LIMIT=8
BURP_MCP_FETCH_SCANNER_ISSUES=true
BURP_MCP_CACHE_TTL_SECONDS=15
BURP_MCP_DEBOUNCE_WINDOW_MS=250
BURP_MCP_READ_ONLY_ONLY=true
BURP_MCP_ALLOWED_TOOLS=
BURP_MCP_ALLOWED_CAPABILITIES=
# To let the bridge open Repeater tabs directly, set:
# BURP_MCP_ALLOWED_CAPABILITIES=send_to_repeater

# Analysis behavior
PRIVACY_MODE=STRICT
SKIP_MODEL_FOR_LOW_SIGNAL=true
BROWSER_VERIFICATION_REQUIRE_EXPLICIT_ALLOW=true
WHITEBOX_MODE_ENABLED=false
WHITEBOX_ROOT=
INTERNET_REFERENCE_ENRICHMENT_ENABLED=true
INTERNET_REFERENCE_MODE=curated-only
AUTO_MODEL_ROUTING_ENABLED=true
# Keep scanner-only findings on OLLAMA_MODEL. The deep model is auto-used only
# when scanner context also includes observed evidence such as a response delta,
# logger evidence, Collaborator evidence, or an evidence timeline.
MODEL_ROUTING_DEEP_SCORE_THRESHOLD=8
MODEL_ROUTING_DEEP_MIN_SIGNAL_COUNT=4

# Storage retention
HISTORY_JSONL_MAX_RECORDS=2000
PROVIDER_DIAGNOSTICS_JSONL_MAX_RECORDS=1500
AUDIT_LOG_JSONL_MAX_RECORDS=1500
PHASE_SNAPSHOT_JSONL_MAX_RECORDS=1500
BURP_SESSION_SNAPSHOT_JSONL_MAX_RECORDS=1000
ISSUE_WORKFLOW_STATE_JSONL_MAX_RECORDS=1500
REVIEW_DATASET_JSONL_MAX_RECORDS=1000
REPEATER_LEARNING_JSONL_MAX_RECORDS=1200
TARGET_MEMORY_PARTITIONING_ENABLED=true
PERSISTENCE_REPLAY_PROTECTION_MODE=hash-raw
PERSISTENCE_STORAGE_SEAL_KEY=

# Observability guardrails
OBSERVABILITY_REQUIRE_LOCAL_OR_AUTH=true
OBSERVABILITY_ALLOW_LOCALHOST=true
OBSERVABILITY_AUTH_TOKEN=
